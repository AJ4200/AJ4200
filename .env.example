# Create a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key

# Optional. The default is llama-3.1-8b-instant.
GROQ_MODEL=llama-3.1-8b-instant

# Public OAuth client ID for creating styled Gmail drafts on the contact page.
# Create a Web application OAuth client in Google Cloud; never put a client secret here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
